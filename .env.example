# Local development server: change PORT if 4173 is occupied.
PORT=4173

# All values here are PUBLIC and published in the static build. Never add secrets.
# Copy this file to .env, edit it, then run npm run dev or npm run build.
ENABLE_VISITOR_MODE=true
ENABLE_PRESENTATION_MODE=true
PUBLIC_SITE_URL=https://example.org/cybershield/
SHOW_UNIVERSITY_LOGO=true
# Hide application name on the public UI by default
SHOW_BRAND_NAME=false
UNIVERSITY_LOGO_PATH=branding/university-logo.svg
# Optional dark/colored logo for the white infographic masthead (PNG supported)
POSTER_LOGO_PATH=branding/university-logo-poster.svg
POSTER_DURATION_SECONDS=180
EXPERIENCE_IDLE_SECONDS=60
# Only one approved infographic is displayed (no shuffle).
SHOW_QR_AFTER_EXPERIENCE=true
DEFAULT_LANGUAGE=ar
BRAND_PRIMARY=#1c4379
BRAND_SECONDARY=#28b6ba
SITE_NAME=CyberShield
# On public HTTPS deployments the current page URL can be used for QR if this value
# is left as the placeholder. On local laptops configure the real visitor URL.
